# General Configuration
PROJECT_NAME="MahaTransit AI - Complaint Management System"
API_V1_STR="/api/v1"

# Database Configuration (Supabase PostgreSQL URI)
# Found in Supabase Dashboard -> Project Settings -> Database -> Connection URI
# e.g., postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
DATABASE_URL=

# Supabase Storage & API Configuration
# Found in Supabase Dashboard -> Project Settings -> API (Project URL & Anon/Service Key)
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_BUCKET=complaint-attachments

# ── AI / ML SETTINGS ─────────────────────────────────────
# Models run 100% locally via PyTorch (No paid API keys needed)
WHISPER_MODEL_SIZE=base
XGBOOST_MODEL_PATH=./models/priority_xgb_model.joblib

# Optional: Only needed if using gated models on Hugging Face (e.g., meta-llama or private NLLB checkpoints).
# Helsinki-NLP MarianMT models are ungated and do NOT require this token.
HF_TOKEN=
